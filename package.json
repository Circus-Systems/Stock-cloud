{
  "name": "stock-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that archives the full filing/announcement history of a share portfolio into R2 and checks for new filings daily",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.156.0"
  }
}
